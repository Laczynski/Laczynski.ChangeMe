# Copy to deploy/ansible/inventory/host_vars/ci-lab.yml and adjust ansible_host.
# Add ci-lab under application_instances.hosts in deploy/ansible/inventory/hosts.yml.
# See ci-lab/README.md for the full workflow.

deployment_enabled: false
deployment_tier: development
gitlab_environment: development/ci-lab

ansible_host: 192.168.64.10
ansible_port: 22

public_url: http://192.168.64.10
server_name: 192.168.64.10
frontend_api_url: /api/v1
health_path: /health

nginx_tls_enabled: false
nginx_tls_certificate_path: ""
nginx_tls_certificate_key_path: ""

deployment_public_keys:
  - ssh-ed25519 AAAA...replace-with-public-key-from-ci-lab-keys-deployment.pub

backend_config:
  AuthOptions__FrontendBaseUrl: http://192.168.64.10
  AuthOptions__Jwt__Issuer: Template
  AuthOptions__Jwt__Audience: Template.Client
  AuthOptions__Jwt__ExpirationMinutes: "30"
  AuthOptions__Jwt__SessionLifetimeDays: "14"
  DatabaseOptions__ApplyMigrationsOnStartup: "false"
  EmailOptions__Host: smtp.example.invalid
  EmailOptions__Port: "587"
  EmailOptions__EnableSsl: "true"
  EmailOptions__FromEmail: no-reply@example.invalid
  EmailOptions__FromName: Template
  FileStorageOptions__RootPath: /var/lib/change-me/storage
