<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>ChangeMe</PackageId>
    <Version>4.0.0</Version>
    <PackageReleaseNotes>See CHANGELOG.md — sourceName ChangeMe, dotnet new changeme, schema changeme_backend.</PackageReleaseNotes>
    <Title>ChangeMe</Title>
    <Authors>Damian Łączyński</Authors>
    <Description>Full-stack dotnet new starter template with Angular frontend, layered ASP.NET backend, PostgreSQL, Docker Compose, tests, and project documentation.</Description>
    <PackageTags>dotnet-new;template;starter;angular;aspnetcore;fullstack;changeme</PackageTags>
    <PackageType>Template</PackageType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NuGetPackageREADME.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Laczynski/Laczynski.ChangeMe</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Laczynski/Laczynski.ChangeMe</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Copyright>Copyright (c) 2026 Damian Łączyński</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NuGetPackageREADME.md" Pack="true" PackagePath="\" />
    <Content Include="..\.env.example" Pack="true" PackagePath="content" />
    <Content Include="..\**\*"
             Exclude="
               ..\.env;
               ..\.env.*;
               ..\.git\**;
               ..\.github\**;
               ..\.angular\**;
               ..\**\.angular\**;
               ..\.template.config\**;
               ..\.template-test\**;
               ..\.template-test-output\**;
               ..\**\.template-test-output\**;
               ..\maintainer\**;
               ..\template-content\**;
               ..\template-pack\**;
               ..\ci-lab\**;
               ..\artifacts\**;
               ..\CHANGELOG.md;
               ..\README.md;
               ..\CONTRIBUTING.md;
               ..\**\bin\**;
               ..\**\obj\**;
               ..\**\node_modules\**;
               ..\**\dist\**;
               ..\**\coverage\**;
               ..\**\.vs\**;
               ..\**\TestResults\**;
               ..\**\logs\**;
               ..\**\*.log;
               ..\*.nupkg"
             Pack="true"
             PackagePath="content" />
  </ItemGroup>

</Project>
