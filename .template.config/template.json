{
  "$schema": "https://json.schemastore.org/template",
  "author": "Damian Łączyński",
  "classifications": ["Web", "API", "SPA"],
  "identity": "Laczynski.Template.FullStack",
  "name": "Laczynski full-stack",
  "shortName": "laczynski-fullstack",
  "sourceName": "Template",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "ProjectNameCamelCase": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "projectNameCamelCase",
      "replaces": "changeMe"
    },
    "ProjectNameScreamingSnake": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "projectNameScreamingSnake",
      "replaces": "CHANGE_ME"
    },
    "ProjectNameKebabCase": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "projectNameKebabCase",
      "replaces": "change-me"
    }
  },
  "forms": {
    "projectNameCamelCase": {
      "identifier": "firstLowerCaseInvariant"
    },
    "projectNameScreamingSnake": {
      "identifier": "chain",
      "steps": ["projectNamePascalToSnake", "projectNameUpperCase"]
    },
    "projectNamePascalToSnake": {
      "identifier": "replace",
      "pattern": "([a-z])([A-Z])",
      "replacement": "$1_$2"
    },
    "projectNameUpperCase": {
      "identifier": "upperCaseInvariant"
    },
    "projectNameKebabCase": {
      "identifier": "chain",
      "steps": ["projectNamePascalToKebab", "projectNameSeparatorsToKebab", "projectNameLowerCase"]
    },
    "projectNamePascalToKebab": {
      "identifier": "replace",
      "pattern": "([a-z0-9])([A-Z])",
      "replacement": "$1-$2"
    },
    "projectNameSeparatorsToKebab": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]+",
      "replacement": "-"
    },
    "projectNameLowerCase": {
      "identifier": "lowerCaseInvariant"
    }
  },
  "primaryOutputs": [{ "path": "src/Template.Backend/Template.Backend.slnx" }],
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            "template-content/**",
            ".git/**",
            ".angular/**",
            ".tmp-template-inspect/**",
            ".template-test-output/**",
            "artifacts/**",
            "template-pack/**",
            ".github/workflows/publish.yml",
            "**/node_modules/**",
            "**/bin/**",
            "**/obj/**",
            "**/dist/**",
            "**/.vs/**",
            "**/TestResults/**",
            "**/logs/**",
            "*.nupkg",
            "README.md",
            "CONTRIBUTING.md",
            "CHANGELOG.md"
          ]
        }
      ]
    },
    {
      "source": "template-content/generated-readme/",
      "target": "./"
    }
  ]
}
