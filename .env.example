# Copy this file to .env and replace every "replace-..." value for local development.
POSTGRES_DB=ChangeMe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-for-local-development

ConnectionStrings__DefaultConnection="Host=localhost;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

AuthOptions__Jwt__SigningKey=replace-with-at-least-32-random-characters

InitialAdministratorOptions__Email=admin@example.local
InitialAdministratorOptions__Password=replace-for-local-development-123A
InitialAdministratorOptions__FirstName=System
InitialAdministratorOptions__LastName=Administrator

# Leave both values empty when the local SMTP server permits anonymous access.
EmailOptions__Username=
EmailOptions__Password=
