{% if nginx_tls_enabled | bool %}
server {
  listen 80;
  server_name {{ server_name }};
  return 301 https://$host$request_uri;
}

{% endif %}
server {
{% if nginx_tls_enabled | bool %}
  listen 443 ssl;
  ssl_certificate {{ nginx_tls_certificate_path }};
  ssl_certificate_key {{ nginx_tls_certificate_key_path }};
{% else %}
  listen 80;
{% endif %}
  server_name {{ server_name }};
  server_tokens off;

  root {{ application_current_path }}/frontend;
  index index.html;

  location = {{ health_path }} {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    proxy_pass {{ application_backend_url }};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    proxy_pass {{ application_backend_url }};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /hubs/ {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    proxy_pass {{ application_backend_url }};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }

  location = /runtime-config.js {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    alias {{ application_current_config_path }}/frontend-runtime.js;
    add_header Cache-Control "no-cache" always;
  }

  location = /theme-init.js {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  location ~* \.(js|css|woff2?|ico|png|svg|webp|json|txt|xml)$ {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/snippets/{{ application_name }}-security-headers.conf;
    add_header Cache-Control "no-cache" always;
    gzip off;
    sub_filter_types text/html;
    sub_filter_once off;
    sub_filter '__CSP_NONCE__' '$csp_nonce';
    try_files $uri $uri/ /index.html;
  }
}
