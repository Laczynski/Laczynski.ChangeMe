{
  "DatabaseOptions": {
    "ApplyMigrationsOnStartup": true
  },
  "HangfireOptions": {
    "DashboardPath": "/hangfire",
    "DashboardEnabled": true,
    "ServerEnabled": true
  },
  "SwaggerOptions": {
    "Enabled": true
  },
  "NotificationRetentionOptions": {
    "UnreadRetentionDays": 90,
    "ReadRetentionDays": 30,
    "AbsoluteRetentionDays": 180,
    "CleanupCronExpression": "0 3 * * *"
  },
  "FileStorageOptions": {
    "RootPath": "../../storage",
    "CleanupCronExpression": "0 * * * *",
    "CleanupConcurrentExecutionTimeoutSeconds": 3600
  },
  "CorsOptions": {
    "AllowedOrigins": ["http://localhost:4200", "https://localhost:4200"]
  },
  "RateLimitingOptions": {
    "Enabled": false
  },
  "AuthOptions": {
    "FrontendBaseUrl": "http://localhost:4200",
    "Jwt": {
      "Issuer": "Template.Dev",
      "Audience": "Template.Frontend",
      "ExpirationMinutes": 30,
      "SessionLifetimeDays": 14
    },
    "PasswordPolicy": {
      "MinimumLength": 8,
      "MaximumLength": 128,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": false
    }
  },
  "DataGeneratorOptions": {
    "Seed": 20260522,
    "Users": 8,
    "Issues": 25,
    "CommentsPerIssueMin": 0,
    "CommentsPerIssueMax": 4,
    "NotificationsPerUserMin": 0,
    "NotificationsPerUserMax": 3,
    "DefaultPassword": "Demo123!",
    "EmailDomain": "demo.local"
  },
  "EmailOptions": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromEmail": "no-reply@example.local",
    "FromName": "Template System"
  },
  "SerilogOptions": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:O}] [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../../logs/template.backend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 1,
          "shared": true,
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
