{
  "name": "laczynski-template",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:deployment": "node scripts/run-deployment-command.mjs setup",
    "validate:deployment": "node scripts/run-deployment-command.mjs validate",
    "prepare": "node scripts/prepare.mjs",
    "install:frontend": "npm --prefix src/Template.Frontend install && npm --prefix src/Template.Frontend exec playwright install chromium",
    "start:frontend": "npm --prefix src/Template.Frontend run start",
    "start:backend": "dotnet run --project src/Template.Backend/src/Template.Backend.Web/Template.Backend.Web.csproj",
    "start:all": "concurrently -n frontend,backend -c cyan,green \"npm run start:frontend\" \"npm run start:backend\"",
    "build:frontend": "npm --prefix src/Template.Frontend run build",
    "build:backend": "dotnet build src/Template.Backend/Template.Backend.slnx",
    "build:all": "npm run build:frontend && npm run build:backend",
    "lint:frontend": "npm --prefix src/Template.Frontend run lint",
    "format:check:frontend": "npm --prefix src/Template.Frontend run format:check",
    "format:check:backend": "dotnet format src/Template.Backend/Template.Backend.slnx --severity warn --verify-no-changes --exclude \"**/Persistence/Migrations/**\"",
    "format:check:all": "npm run format:check:frontend && npm run format:check:backend",
    "format:frontend": "npm --prefix src/Template.Frontend run format",
    "format:backend": "dotnet format src/Template.Backend/Template.Backend.slnx --severity warn --exclude \"**/Persistence/Migrations/**\"",
    "format:all": "npm run format:frontend && npm run format:backend",
    "test:frontend": "npm --prefix src/Template.Frontend run test",
    "test:frontend:ci": "npm --prefix src/Template.Frontend run test:ci",
    "test:frontend:coverage": "npm --prefix src/Template.Frontend run test:coverage",
    "test:backend": "dotnet test src/Template.Backend/Template.Backend.slnx",
    "test:backend:unit": "dotnet test src/Template.Backend/tests/Template.Backend.UnitTests",
    "test:backend:integration": "dotnet test src/Template.Backend/tests/Template.Backend.IntegrationTests",
    "test:all": "concurrently -n fe,be -c cyan,blue \"npm run test:frontend:ci\" \"npm run test:backend\"",
    "test:e2e": "npm --prefix src/Template.Frontend run e2e",
    "test:e2e:ui": "npm --prefix src/Template.Frontend run e2e:ui",
    "ef:migrations:add": "dotnet ef migrations add --project src/Template.Backend/src/Template.Backend.Infrastructure/Template.Backend.Infrastructure.csproj --startup-project src/Template.Backend/src/Template.Backend.Web/Template.Backend.Web.csproj --output-dir Persistence/Migrations",
    "ef:migrations:remove": "dotnet ef migrations remove --project src/Template.Backend/src/Template.Backend.Infrastructure/Template.Backend.Infrastructure.csproj --startup-project src/Template.Backend/src/Template.Backend.Web/Template.Backend.Web.csproj",
    "ef:database:update": "dotnet ef database update --project src/Template.Backend/src/Template.Backend.Infrastructure/Template.Backend.Infrastructure.csproj --startup-project src/Template.Backend/src/Template.Backend.Web/Template.Backend.Web.csproj",
    "data:generate": "dotnet run --no-launch-profile --project src/Template.Backend/tools/Template.Backend.DataGenerator/Template.Backend.DataGenerator.csproj --",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:test:backend": "docker compose --profile test run --rm backend-tests",
    "docs:validate": "node scripts/docs-validate.mjs",
    "pack:backend": "dotnet pack template-pack/Laczynski.Template.csproj -c Release"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "lefthook": "^2.1.10"
  }
}
